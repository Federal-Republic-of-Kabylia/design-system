{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1180px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "night", "color": "#062536", "name": "Night" },
        { "slug": "ink", "color": "#102A39", "name": "Ink" },
        { "slug": "sky", "color": "#0D5F89", "name": "Sky" },
        { "slug": "forest", "color": "#276247", "name": "Forest" },
        { "slug": "gold", "color": "#D9A62D", "name": "Gold" },
        { "slug": "paper", "color": "#F5F2EA", "name": "Paper" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ],
      "gradients": []
    },
    "spacing": {
      "spacingScale": { "steps": 7 },
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "DM Sans, Segoe UI, sans-serif", "slug": "body", "name": "DM Sans" },
        { "fontFamily": "Space Grotesk, DM Sans, sans-serif", "slug": "display", "name": "Space Grotesk" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1.125rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(2rem, 4vw, 3.5rem)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(3rem, 7vw, 6rem)", "name": "Display" }
      ]
    },
    "blocks": {
      "core/button": { "border": { "radius": "3px" } },
      "core/group": { "spacing": { "blockGap": "var:preset|spacing|40" } }
    }
  },
  "styles": {
    "color": { "background": "#FFFFFF", "text": "#102A39" },
    "typography": { "fontFamily": "var:preset|font-family|body", "lineHeight": "1.6" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "letterSpacing": "-0.04em", "lineHeight": "1.05" } },
      "link": { "color": { "text": "var:preset|color|forest" } }
    },
    "blocks": {
      "core/button": { "border": { "radius": "3px" }, "spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "17px", "right": "17px" } } },
      "core/navigation": { "typography": { "fontWeight": "600" } }
    }
  }
}
